# Set whichever of these you actually have. If both are set, ANTHROPIC_API_KEY
# wins unless you force a provider with LLM_PROVIDER=gemini.
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# Optional: force the backend instead of auto-detecting from the keys above.
# LLM_PROVIDER=gemini

# Self-imposed cap on Gemini calls/minute (on top of whatever Google's own
# per-model quota is — free-tier quotas can be much lower than this).
GEMINI_RATE_LIMIT_PER_MIN=60

# SEC EDGAR requires a real contact identity in the User-Agent header on every
# request (https://www.sec.gov/os/webmaster-faq#developers). Use your own name/email.
SEC_EDGAR_USER_AGENT=CreditLens yourname@example.com
